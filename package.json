{
  "name": "gitvision-x",
  "displayName": "GitVision X",
  "description": "Line-level blame and a cursor-synced commit graph in one quiet, fast workspace.",
  "version": "0.0.1",
  "publisher": "tigranmk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tigranmk/gitvision-x"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitvision.rebuildIndex",
        "title": "Rebuild Commit Index",
        "category": "GitVision"
      },
      {
        "command": "gitvision.showIndexStats",
        "title": "Show Commit Index Stats",
        "category": "GitVision"
      },
      {
        "command": "gitvision.blame.toggle",
        "title": "Toggle Inline Blame",
        "category": "GitVision"
      },
      {
        "command": "gitvision.blame.blameFile",
        "title": "Blame This File",
        "category": "GitVision"
      },
      {
        "command": "gitvision.blame.openCommitDiff",
        "title": "Open Commit Diff",
        "category": "GitVision"
      },
      {
        "command": "gitvision.blame.copySha",
        "title": "Copy Commit SHA",
        "category": "GitVision"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitvision.blame.openCommitDiff",
          "when": "false"
        },
        {
          "command": "gitvision.blame.copySha",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "GitVision",
      "properties": {
        "gitvision.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show blame as ghost text on the active line."
        },
        "gitvision.blame.gutterHeatmap": {
          "type": "boolean",
          "default": false,
          "description": "Colour the gutter by line age (newest warm, oldest cool)."
        },
        "gitvision.blame.statusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show the active line's author in the status bar."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "pnpm build:prod && node test/integration/run.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "bench": "node bench/run.mjs",
    "package": "pnpm build:prod && vsce package --no-dependencies"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "mocha": "^11.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@gvx/git-engine": "workspace:*",
    "@gvx/host": "workspace:*",
    "@gvx/protocol": "workspace:*"
  }
}
