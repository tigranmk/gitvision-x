{
  "name": "gitvision-x",
  "displayName": "GitVision X",
  "description": "Fast, quiet git blame for the line you're on, and a commit graph that follows your cursor.",
  "version": "0.0.1",
  "publisher": "tigranmk",
  "preview": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "keywords": [
    "git",
    "blame",
    "annotations",
    "history",
    "line history",
    "authorship",
    "inline blame",
    "graph",
    "commit graph",
    "git graph"
  ],
  "homepage": "https://github.com/tigranmk/gitvision-x#readme",
  "bugs": {
    "url": "https://github.com/tigranmk/gitvision-x/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tigranmk/gitvision-x"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "GitVision X runs git in the workspace, and a repository's git config can make git run programs. It is disabled until you trust the folder."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "GitVision X needs a local git repository on disk."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitvision.rebuildIndex",
        "title": "Rebuild Commit Index",
        "category": "GitVision"
      },
      {
        "command": "gitvision.showIndexStats",
        "title": "Show Commit Index Stats",
        "category": "GitVision"
      },
      {
        "command": "gitvision.blame.toggle",
        "title": "Toggle Inline Blame",
        "category": "GitVision"
      },
      {
        "command": "gitvision.blame.blameFile",
        "title": "Blame This File",
        "category": "GitVision"
      },
      {
        "command": "gitvision.blame.openCommitDiff",
        "title": "Open Commit Diff",
        "category": "GitVision"
      },
      {
        "command": "gitvision.blame.copySha",
        "title": "Copy Commit SHA",
        "category": "GitVision"
      },
      {
        "command": "gitvision.graph.openBeside",
        "title": "Open Graph Beside",
        "category": "GitVision",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "gitvision.graph.checkout",
        "title": "Check Out…",
        "category": "GitVision"
      },
      {
        "command": "gitvision.graph.createBranch",
        "title": "Create Branch…",
        "category": "GitVision"
      },
      {
        "command": "gitvision.graph.createTag",
        "title": "Create Tag…",
        "category": "GitVision"
      },
      {
        "command": "gitvision.graph.cherryPick",
        "title": "Cherry-Pick…",
        "category": "GitVision"
      },
      {
        "command": "gitvision.graph.revert",
        "title": "Revert…",
        "category": "GitVision"
      },
      {
        "command": "gitvision.graph.reset",
        "title": "Reset Current Branch to Here…",
        "category": "GitVision"
      },
      {
        "command": "gitvision.graph.compareWithHead",
        "title": "Compare with HEAD",
        "category": "GitVision"
      },
      {
        "command": "gitvision.graph.copySha",
        "title": "Copy Commit SHA",
        "category": "GitVision"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitvision.blame.openCommitDiff",
          "when": "false"
        },
        {
          "command": "gitvision.blame.copySha",
          "when": "false"
        },
        {
          "command": "gitvision.graph.checkout",
          "when": "false"
        },
        {
          "command": "gitvision.graph.createBranch",
          "when": "false"
        },
        {
          "command": "gitvision.graph.createTag",
          "when": "false"
        },
        {
          "command": "gitvision.graph.cherryPick",
          "when": "false"
        },
        {
          "command": "gitvision.graph.revert",
          "when": "false"
        },
        {
          "command": "gitvision.graph.reset",
          "when": "false"
        },
        {
          "command": "gitvision.graph.compareWithHead",
          "when": "false"
        },
        {
          "command": "gitvision.graph.copySha",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gitvision.graph.openBeside",
          "when": "view == gitvision.graph",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "gitvision.graph.checkout",
          "when": "(webviewId == 'gitvision.graph' || webviewId == 'gitvision.graphPanel') && webviewSection == 'commit'",
          "group": "1_checkout@1"
        },
        {
          "command": "gitvision.graph.createBranch",
          "when": "(webviewId == 'gitvision.graph' || webviewId == 'gitvision.graphPanel') && webviewSection == 'commit'",
          "group": "1_checkout@2"
        },
        {
          "command": "gitvision.graph.createTag",
          "when": "(webviewId == 'gitvision.graph' || webviewId == 'gitvision.graphPanel') && webviewSection == 'commit'",
          "group": "1_checkout@3"
        },
        {
          "command": "gitvision.graph.cherryPick",
          "when": "(webviewId == 'gitvision.graph' || webviewId == 'gitvision.graphPanel') && webviewSection == 'commit'",
          "group": "2_apply@1"
        },
        {
          "command": "gitvision.graph.revert",
          "when": "(webviewId == 'gitvision.graph' || webviewId == 'gitvision.graphPanel') && webviewSection == 'commit'",
          "group": "2_apply@2"
        },
        {
          "command": "gitvision.graph.reset",
          "when": "(webviewId == 'gitvision.graph' || webviewId == 'gitvision.graphPanel') && webviewSection == 'commit'",
          "group": "2_apply@3"
        },
        {
          "command": "gitvision.graph.compareWithHead",
          "when": "(webviewId == 'gitvision.graph' || webviewId == 'gitvision.graphPanel') && webviewSection == 'commit'",
          "group": "3_compare@1"
        },
        {
          "command": "gitvision.graph.copySha",
          "when": "(webviewId == 'gitvision.graph' || webviewId == 'gitvision.graphPanel') && webviewSection == 'commit'",
          "group": "4_copy@1"
        }
      ]
    },
    "configuration": {
      "title": "GitVision",
      "properties": {
        "gitvision.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show blame as ghost text on the active line."
        },
        "gitvision.blame.gutterHeatmap": {
          "type": "boolean",
          "default": false,
          "description": "Colour the gutter by line age (newest warm, oldest cool)."
        },
        "gitvision.blame.statusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show the active line's author in the status bar."
        },
        "gitvision.blame.offerCommitGraph": {
          "type": "boolean",
          "default": true,
          "description": "In repositories with 10,000+ commits, offer once to let git build its commit-graph with changed-path Bloom filters (roughly 40% faster first-time blame of old lines)."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "gitvision",
          "title": "GitVision",
          "icon": "media/graph.svg"
        }
      ]
    },
    "views": {
      "gitvision": [
        {
          "type": "webview",
          "id": "gitvision.graph",
          "name": "Graph",
          "icon": "media/graph.svg",
          "contextualTitle": "GitVision"
        }
      ]
    },
    "colors": [
      {
        "id": "gitvision.headForeground",
        "description": "HEAD marker and current branch chip in the GitVision graph.",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue",
          "highContrastLight": "charts.blue"
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --production",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/e2e-webview/tsconfig.json --noEmit && svelte-check --tsconfig packages/webview-graph/tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "pnpm build:prod && node test/integration/run.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "bench": "node bench/run.mjs",
    "package": "pnpm build:prod && vsce package --no-dependencies",
    "test:webview": "pnpm build && node scripts/fixtures.mjs --only wide-100k && playwright test -c test/e2e-webview/playwright.config.ts"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "@vscode/codicons": "0.0.45",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "mocha": "^11.8.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@gvx/git-engine": "workspace:*",
    "@gvx/host": "workspace:*",
    "@gvx/protocol": "workspace:*",
    "@gvx/ui-tokens": "workspace:*"
  }
}
